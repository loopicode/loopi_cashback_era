{% doc %}
  Renders a cart recommendation region refreshed after cart updates.
{% enddoc %}
{% unless settings.loopi_cart_upsells == false %}
  {% if cart.item_count > 0 %}
    <loopi-cart-upsells class="loopi-cart-upsells" data-product-id="{{ cart.items.first.product_id }}">
      <div data-loopi-upsell-content></div>
    </loopi-cart-upsells>
  {% endif %}
{% endunless %}