{%- comment -%}
  Compact variant of language-localization.liquid for the mobile announcement bar:
  shows the ISO code (DE / EN / FR) in the closed trigger instead of the full
  language name, so it fits at the top of the page on narrow screens. The open
  list still shows full language names for clarity.

  Accepts:
    - localPosition: pass in the position in which the form is coming up to create specific IDs
{%- endcomment -%}

<div class="disclosure">
  <button
    type="button"
    class="disclosure__button localization-form__select localization-selector link link--text caption-large announcement-bar__language-trigger"
    aria-expanded="false"
    aria-controls="{{ localPosition }}List"
    aria-describedby="{{ localPosition }}Label"
  >
    <span>{{ localization.language.iso_code | upcase }}</span>
    {{ 'icon-caret.svg' | inline_asset_content }}
  </button>
  <div class="disclosure__list-wrapper language-selector" hidden>
    <ul id="{{ localPosition }}List" role="list" class="disclosure__list list-unstyled">
      {%- for language in localization.available_languages -%}
        <li class="disclosure__item" tabindex="-1">
          <a
            class="link link--text disclosure__link caption-large focus-inset"
            href="#"
            hreflang="{{ language.iso_code }}"
            lang="{{ language.iso_code }}"
            {% if language.iso_code == localization.language.iso_code %}
              aria-current="true"
            {% endif %}
            data-value="{{ language.iso_code }}"
          >
            <span
              {% if language.iso_code != localization.language.iso_code %}
                class="visibility-hidden"
              {% endif %}
            >
              {{- 'icon-checkmark.svg' | inline_asset_content -}}
            </span>
            <span>
              {{ language.endonym_name | capitalize }}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
<input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
<script>
  (function () {
    var trigger = document.querySelector('.announcement-bar__language-trigger');
    if (!trigger) return;
    var disclosure = trigger.closest('.disclosure');
    var panel = disclosure && disclosure.querySelector('.disclosure__list-wrapper');
    if (!panel) return;

    function closePanel() {
      if (panel.hasAttribute('hidden')) return;
      panel.setAttribute('hidden', '');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden-mobile');
      var drawer = document.querySelector('.menu-drawer');
      if (drawer) drawer.classList.remove('country-selector-open');
    }

    // Tapping the trigger again while the dropdown is open should close it.
    // Three earlier approaches all relied on the `click` event (attachment
    // order, capture phase, stopPropagation) and all failed on a real
    // iPhone. The likely reason: iOS can interpret a second quick tap on the
    // same spot as part of double-tap-to-zoom gesture disambiguation, which
    // delays or entirely swallows the synthetic `click` event that both
    // localization-form.js and those earlier fixes depended on — no amount
    // of clever `click` handling helps if `click` never fires.
    //
    // `touchstart` fires immediately on physical contact, before any of that
    // gesture disambiguation happens. Calling preventDefault() on it tells
    // the browser to skip its default touch handling for this touch
    // entirely — including the zoom gesture AND the follow-up synthetic
    // click — so we close the panel ourselves directly, without ever
    // depending on `click` firing for this specific tap.
    trigger.addEventListener('touchstart', function (event) {
      if (panel.hasAttribute('hidden')) return; // let the normal open flow run via click
      event.preventDefault();
      closePanel();
    }, { passive: false });

    // Non-touch fallback (mouse/trackpad, e.g. desktop at a narrow viewport):
    // on a touch device the touchstart handler above already closed the
    // panel and suppressed the click, so this simply never fires there.
    //
    // assets/localization-form.js attaches its own click listener directly
    // to this same button (`this.elements.button.addEventListener('click',
    // this.openSelector.bind(this))`), and openSelector() itself toggles the
    // panel's hidden attribute. Since that listener sits on the exact same
    // element as this one (not an ancestor), a plain stopPropagation() here
    // does NOT stop it from also running on the same click event — it only
    // blocks propagation to ancestors. Without stopImmediatePropagation(),
    // our closePanel() call was immediately undone by openSelector()
    // re-toggling `hidden` back off right after — invisible on touch (where
    // preventDefault on touchstart stops the click from firing at all) but
    // visible on a real desktop mouse click, where the click always fires.
    trigger.addEventListener('click', function (event) {
      if (!panel.hasAttribute('hidden')) {
        event.stopImmediatePropagation();
        closePanel();
      }
    });

    // Tap/click anywhere outside also closes it — localization-form.js only
    // closes on `focusout`, which mobile Safari/Chrome don't reliably fire
    // for non-focusable taps (like the announcement text next to it).
    function handleOutside(event) {
      if (panel.hasAttribute('hidden')) return;
      if (panel.contains(event.target) || disclosure.contains(event.target)) return;
      closePanel();
    }
    document.addEventListener('touchstart', handleOutside);
    document.addEventListener('click', handleOutside, true);
  })();
</script>
