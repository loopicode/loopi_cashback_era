            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <h2 class="ai-utility-bar-modal-title-{{ ai_gen_id }}">{{ block.settings.location_modal_title }}</h2>
        {% if block.settings.google_maps_embed != blank %}
          <div class="ai-utility-bar-map-container-{{ ai_gen_id }}">
            {{ block.settings.google_maps_embed }}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_hours %}
    <div class="ai-utility-bar-modal-{{ ai_gen_id }}" data-hours-modal>
      <div class="ai-utility-bar-modal-content-{{ ai_gen_id }}">
        <button type="button" class="ai-utility-bar-modal-close-{{ ai_gen_id }}" data-hours-modal-close aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <h2 class="ai-utility-bar-modal-title-{{ ai_gen_id }}">{{ block.settings.hours_modal_title }}</h2>
        <table class="ai-utility-bar-hours-table-{{ ai_gen_id }}">
          {% if block.settings.monday_hours != blank %}
            <tr>
              <td>{{ block.settings.monday_label }}</td>
              <td>{{ block.settings.monday_hours }}</td>
            </tr>
          {% endif %}
          {% if block.settings.tuesday_hours != blank %}
            <tr>
              <td>{{ block.settings.tuesday_label }}</td>
              <td>{{ block.settings.tuesday_hours }}</td>
            </tr>
          {% endif %}
          {% if block.settings.wednesday_hours != blank %}
            <tr>
              <td>{{ block.settings.wednesday_label }}</td>
              <td>{{ block.settings.wednesday_hours }}</td>
            </tr>
          {% endif %}
          {% if block.settings.thursday_hours != blank %}
            <tr>
              <td>{{ block.settings.thursday_label }}</td>
              <td>{{ block.settings.thursday_hours }}</td>
            </tr>
          {% endif %}
          {% if block.settings.friday_hours != blank %}
            <tr>
              <td>{{ block.settings.friday_label }}</td>
              <td>{{ block.settings.friday_hours }}</td>
            </tr>
          {% endif %}
          {% if block.settings.saturday_hours != blank %}
            <tr>
              <td>{{ block.settings.saturday_label }}</td>
              <td>{{ block.settings.saturday_hours }}</td>
            </tr>
          {% endif %}
          {% if block.settings.sunday_hours != blank %}
            <tr>
              <td>{{ block.settings.sunday_label }}</td>
              <td>{{ block.settings.sunday_hours }}</td>
            </tr>
          {% endif %}
        </table>
      </div>
    </div>
  {% endif %}
</utility-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class UtilityBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.hoursModal = this.querySelector('[data-hours-modal]');
        this.hoursModalTrigger = this.querySelector('[data-hours-modal-trigger]');
        this.hoursModalClose = this.querySelector('[data-hours-modal-close]');

        this.locationModal = this.querySelector('[data-location-modal]');
        this.locationModalTrigger = this.querySelector('[data-location-modal-trigger]');
        this.locationModalClose = this.querySelector('[data-location-modal-close]');

        if (this.hoursModalTrigger && this.hoursModal) {
          this.hoursModalTrigger.addEventListener('click', () => this.openModal(this.hoursModal));
        }

        if (this.hoursModalClose && this.hoursModal) {
          this.hoursModalClose.addEventListener('click', () => this.closeModal(this.hoursModal));
        }

        if (this.locationModalTrigger && this.locationModal) {
          this.locationModalTrigger.addEventListener('click', () => this.openModal(this.locationModal));
        }

        if (this.locationModalClose && this.locationModal) {
          this.locationModalClose.addEventListener('click', () => this.closeModal(this.locationModal));
        }

        if (this.hoursModal) {
          this.hoursModal.addEventListener('click', (e) => {
            if (e.target === this.hoursModal) {
              this.closeModal(this.hoursModal);
            }
          });
        }

        if (this.locationModal) {
          this.locationModal.addEventListener('click', (e) => {
            if (e.target === this.locationModal) {
              this.closeModal(this.locationModal);
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (this.hoursModal && this.hoursModal.classList.contains('active')) {
              this.closeModal(this.hoursModal);
            }
            if (this.locationModal && this.locationModal.classList.contains('active')) {
              this.closeModal(this.locationModal);
            }
          }
        });
      }

      openModal(modal) {
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }

      closeModal(modal) {
        if (modal) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
        }
      }
    }

    customElements.define('utility-bar-{{ ai_gen_id }}', UtilityBar{{ ai_gen_id }});
  })();
</script>

