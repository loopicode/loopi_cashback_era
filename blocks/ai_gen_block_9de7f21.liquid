{% doc %}
  @prompt
    Clone the existing block `ai_gen_block_442903e` in section `sections--26298232635766__1772140546508b67b8` (the Utility Bar / opening hours block) and create a new identical block with all the same content and styling, but add the following extra settings to the schema: 1) A "Holiday Mode" checkbox toggle (default: false). 2) A "Holiday Message" textarea field for free text configuration (default text: "We are currently on holiday this week. You can reach us at abo@loopi.ch"). When Holiday Mode is ON, hide the regular opening hours content and display the custom holiday message text instead, styled prominently and consistently with the rest of the block. When Holiday Mode is OFF, show the regular content as normal.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-utility-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-utility-bar-content-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
  }

  .ai-utility-bar-hours-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.text_alignment }};
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-utility-bar-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-utility-bar-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-utility-bar-text-{{ ai_gen_id }} {
    line-height: 1.4;
  }

  .ai-utility-bar-holiday-{{ ai_gen_id }} {
    font-weight: {{ block.settings.holiday_font_weight }};
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-utility-bar-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-utility-bar-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-utility-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-utility-bar-content-{{ ai_gen_id }}">
    {% if block.settings.holiday_mode %}
      <div class="ai-utility-bar-holiday-{{ ai_gen_id }}">
        {{ block.settings.holiday_message }}
      </div>
    {% else %}
      <div class="ai-utility-bar-hours-{{ ai_gen_id }}">
        {% if block.settings.show_icon %}
          <div class="ai-utility-bar-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
        {% endif %}
        <div class="ai-utility-bar-text-{{ ai_gen_id }}">
          {{ block.settings.opening_hours_text }}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Opening hours utility bar",
  "settings": [
    {
      "type": "header",
      "content": "Holiday mode"
    },
    {
      "type": "checkbox",
      "id": "holiday_mode",
      "label": "Enable holiday mode",
      "default": false
    },
    {
      "type": "textarea",
      "id": "holiday_message",
      "label": "Holiday message",
      "default": "We are currently on holiday this week. You can reach us at abo@loopi.ch"
    },
    {
      "type": "select",
      "id": "holiday_font_weight",
      "label": "Holiday message weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Opening hours"
    },
    {
      "type": "textarea",
      "id": "opening_hours_text",
      "label": "Opening hours text",
      "default": "Monday - Friday: 9:00 - 17:00"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show clock icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#97A74D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Opening hours utility bar"
    }
  ]
}
{% endschema %}
