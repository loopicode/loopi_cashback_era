            "custom_liquid": "<style>\n.product h1, h1.product-title, .product__title, .main-product h1 {\n  font-size: 2.9rem !important;\n  font-weight: 700 !important;\n  color: #000;\n  line-height: 1.2;\n  margin-bottom: 0;\n}\n@media screen and (min-width: 750px) {\n  .product h1, h1.product-title, .product__title, .main-product h1 {\n    font-size: 3.4rem !important;\n  }\n}\n.product-subtitle {\n  display: block;\n  font-size: 1.6rem;\n  font-weight: 400;\n  color: #646464;\n  margin-top: 0.5em;\n  line-height: 1.3;\n}\n.product .price .price-item {\n  font-size: 2.2rem !important;\n  font-weight: 700 !important;\n  letter-spacing: normal !important;\n}\n[id^=\"price-\"] .price--on-sale .price-item--regular {\n  font-size: 1.3rem !important;\n  font-weight: 400 !important;\n  color: rgba(var(--color-foreground), 0.75) !important;\n}\n.accordion__title {\n  font-size: 1.6rem !important;\n  font-weight: 400 !important;\n}\n.product .form__label {\n  font-size: 1.4rem !important;\n}\n.accordion summary {\n  align-items: center;\n}\n.accordion .summary__title {\n  align-items: center;\n}\n.accordion .summary__title .svg-wrapper {\n  transform: translateY(-8px);\n}\n.product__tax {\n  margin-top: -2.6rem !important;\n  margin-bottom: 0.5rem !important;\n}\n.per-month, .one-time {\n  font-size: 1rem !important;\n  letter-spacing: 0.07rem !important;\n  font-weight: 400 !important;\n  color: rgba(var(--color-foreground), 0.75) !important;\n}\n@media screen and (min-width: 750px) {\n  .per-month, .one-time {\n    font-size: 1.2rem !important;\n  }\n}\n.product-description-content h2,\n.product-description-content h3 {\n  font-size: 1.6rem !important;\n  font-weight: 400 !important;\n}\n.product-description-content p,\n.product-description-content li {\n  font-size: 1.4rem !important;\n  line-height: 1.4 !important;\n}\n.multicolumn-card__info h3 {\n  font-size: 1.6rem !important;\n  font-weight: 400 !important;\n}\n.multicolumn-card__info .rte p {\n  font-size: 1.4rem !important;\n  line-height: 1.4 !important;\n}\nfieldset.product-form__input--pill {\n  display: flex !important;\n  flex-wrap: wrap !important;\n  gap: 0.8rem !important;\n  width: 100% !important;\n  max-width: 100% !important;\n}\nfieldset.product-form__input--pill legend {\n  width: 100% !important;\n  flex: 0 0 100% !important;\n  margin-bottom: 1.2rem !important;\n}\nfieldset.product-form__input--pill input[type='radio']:not(.color-input) + label:not(.color-shape),\nfieldset.product-form__input--pill label.non-color-option:not(.color-shape) {\n  flex: 0 0 calc(50% - 0.4rem) !important;\n  max-width: calc(50% - 0.4rem) !important;\n  min-width: calc(50% - 0.4rem) !important;\n  width: calc(50% - 0.4rem) !important;\n  margin: 0 !important;\n  box-sizing: border-box !important;\n  display: inline-flex !important;\n  height: 47px !important;\n  min-height: 47px !important;\n  align-items: center !important;\n  justify-content: center !important;\n  padding: 0 1.5rem !important;\n  line-height: 1 !important;\n}\n.product-form__input--swatch .swatch-input__input + .swatch-input__label {\n  --swatch-input--size: 47px !important;\n}\n.price .price__badge-sale,\n.price .price__badge-sold-out {\n  font-size: 1.2rem !important;\n  font-weight: 400 !important;\n  letter-spacing: 0.02rem !important;\n  border-radius: 6px !important;\n  padding: 0.5rem 1.3rem 0.6rem 1.3rem !important;\n  line-height: 1 !important;\n}\n.price .price__badge-sale {\n  background-color: rgba(244, 112, 69, 0.13) !important;\n  color: #F47045 !important;\n}\n.price .price__badge-sold-out {\n  background-color: #000000 !important;\n  color: #ffffff !important;\n}\n[id^=\"price-\"] .price {\n  display: flex !important;\n  flex-wrap: wrap !important;\n  align-items: flex-start !important;\n  row-gap: 0 !important;\n  column-gap: 10px !important;\n}\n[id^=\"price-\"] .price > .price__container { order: 1 !important; }\n[id^=\"price-\"] .price > .wrapper { order: 2 !important; }\n[id^=\"price-\"] .price > .product__tax {\n  display: block !important;\n  order: 4 !important;\n  flex: 0 0 100% !important;\n  margin-top: -10px !important;\n  margin-bottom: 0 !important;\n  color: rgba(var(--color-foreground), 0.75) !important;\n}\n.status-badge-slot {\n  order: 5 !important;\n  flex: 0 0 calc(50% - 0.4rem) !important;\n  width: calc(50% - 0.4rem) !important;\n  margin-top: 5px !important;\n}\n.status-badge-slot .badge {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  width: 100% !important;\n  height: 100%;\n  text-align: center;\n}\n@media screen and (min-width: 750px) {\n  .status-badge-slot {\n    order: 3 !important;\n    align-self: center !important;\n    margin-left: auto !important;\n    margin-top: 0 !important;\n    flex: 1 1 0% !important;\n    max-width: calc(50% - 0.4rem) !important;\n    width: auto !important;\n    min-width: 0 !important;\n  }\n}\n[id^=\"price-\"] + .product__tax { display: none !important; }\n</style>\n<script>\n(function() {\n  function splitProductTitle() {\n    const selectors = [\n      '.product__title h1',\n      '.product h1',\n      'h1.product-title',\n      '.main-product h1',\n      '.product-info h1',\n      'h1[class*=\"product\"]'\n    ];\n    let title = null;\n    for (let selector of selectors) {\n      title = document.querySelector(selector);\n      if (title && title.textContent.includes(':')) {\n        break;\n      }\n    }\n    if (title && title.textContent.includes(':') && !title.dataset.split) {\n      const fullText = title.textContent;\n      const colonIndex = fullText.indexOf(':');\n      const mainPart = fullText.substring(0, colonIndex).trim();\n      const subPart = fullText.substring(colonIndex + 1).trim();\n      title.innerHTML = mainPart + '<br><span class=\"product-subtitle\">' + subPart + '</span>';\n      title.dataset.split = 'true';\n    }\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', splitProductTitle);\n  } else {\n    splitProductTitle();\n  }\n})();\n</script>"
