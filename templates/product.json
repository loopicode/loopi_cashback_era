            "custom_liquid": "<style>\n.delivery-note-icon { display:inline-flex; flex-shrink:0; width:24px; height:24px; color:#5C6B4D; }\n.delivery-note-icon svg { width:100%; height:100%; display:block; }\n</style>\n{% if product.metafields.custom.delivery_note.value != blank %}\n  {%- liquid\n    assign use_icon = true\n  -%}\n  <div class=\"delivery-note-badge\" style=\"margin-top:8px;padding:8px 12px;background:rgba(203,195,171,0.4);border-radius:6px;font-size:14px;font-weight:normal;display:flex;align-items:center;gap:8px;\">\n    <span class=\"delivery-note-icon\">\n      {% if use_icon %}{{ 'loopi-icon-lkw.svg' | inline_asset_content }}{% else %}🚚{% endif %}\n    </span>\n    <span>{{ product.metafields.custom.delivery_note.value }}</span>\n  </div>\n{% endif %}"
