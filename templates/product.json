        "custom_liquid_garantie_badge": {
          "type": "custom_liquid",
          "name": "Custom Liquid_garantie-badge",
          "settings": {
            "custom_liquid": "<style>\n.garantie-badge-icon { display:inline-flex; flex-shrink:0; width:24px; height:24px; color:#5C6B4D; }\n.garantie-badge-icon svg { width:100%; height:100%; display:block; }\n</style>\n{% if product.metafields.custom.garantie_badge_text.value != blank %}\n  {%- liquid\n    assign use_icon = true\n    assign zustand_match = false\n    assign laufzeit_match = false\n    for opt in product.selected_or_first_available_variant.selected_options\n      if opt.name == 'Zustand' and opt.value == 'Pre-loved'\n        assign zustand_match = true\n      endif\n      if opt.name == 'Mindestlaufzeit' and opt.value == 'Kaufen'\n        assign laufzeit_match = true\n      endif\n    endfor\n    assign initial_show = false\n    if zustand_match and laufzeit_match\n      assign initial_show = true\n    endif\n  -%}\n  <div class=\"garantie-badge\" id=\"GarantieBadge-{{ section.id }}\" style=\"margin-top:8px;padding:8px 12px;background:rgba(203,195,171,0.4);border-radius:6px;font-size:14px;font-weight:normal;display:{% if initial_show %}flex{% else %}none{% endif %};align-items:center;gap:8px;\">\n    <span class=\"garantie-badge-icon\">\n      {% if use_icon %}{{ 'loopi-icon-schild.svg' | inline_asset_content }}{% else %}✓{% endif %}\n    </span>\n    <span><strong>Garantie</strong> — {{ product.metafields.custom.garantie_badge_text.value }}</span>\n  </div>\n  <script>\n  (function() {\n    var sectionId = {{ section.id | json }};\n    function init() {\n      var badge = document.getElementById('GarantieBadge-' + sectionId);\n      if (!badge) return;\n      function update() {\n        var root = document.getElementById('variant-selects-' + sectionId);\n        if (!root) return;\n        var zustand = root.querySelector('input[name^=\"Zustand-\"]:checked, select[name^=\"Zustand-\"]');\n        var laufzeit = root.querySelector('input[name^=\"Mindestlaufzeit-\"]:checked, select[name^=\"Mindestlaufzeit-\"]');\n        var show = zustand && laufzeit && zustand.value === 'Pre-loved' && laufzeit.value === 'Kaufen';\n        badge.style.display = show ? 'flex' : 'none';\n      }\n      document.addEventListener('change', function(e) {\n        var root = document.getElementById('variant-selects-' + sectionId);\n        if (root && root.contains(e.target)) update();\n      });\n    }\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', init);\n    } else {\n      init();\n    }\n  })();\n  </script>\n{% endif %}"
