{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{{ 'loopi-type.css' | asset_url | stylesheet_tag }}

{%- stylesheet -%}
  .cb-steps__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem 3rem; margin-top: 3.6rem; }
  .cb-steps__actions--left { justify-content: flex-start; }
  .cb-steps__actions--center { justify-content: center; }
  .cb-steps__actions--right { justify-content: flex-end; }
  .cb-wa-group { display: flex; align-items: center; gap: 1.4rem; }
  .cb-wa { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 6.4rem; min-height: 4.5rem; border-radius: var(--buttons-radius-outset, 40px); background: var(--lp-whatsapp, #25D366); color: #fff; text-decoration: none; transition: filter 0.15s ease; }
  .cb-wa:hover { filter: brightness(0.92); }
  .cb-wa svg { display: block; width: 2.6rem; height: 2.6rem; fill: currentColor; }
  .cb-wa-text { margin: 0; max-width: 28rem; }
  .cb-steps__note { margin-top: 1.6rem; font-size: 1.3rem; opacity: 0.75; }
  .cb-steps__note--left { text-align: left; }
  .cb-steps__note--center { text-align: center; }
  .cb-steps__note--right { text-align: right; }
{%- endstylesheet -%}

{%- assign cb_s = section.settings.title_size | plus: 0 -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="lp-head lp-head--{{ section.settings.text_align }}">
        <h2 class="lp-h2" style="{% if cb_s > 0 %}--lp-size: {{ cb_s }}px; --lp-size-t: {{ cb_s | times: 0.9 | round }}px; --lp-size-m: {{ cb_s | times: 0.8 | round }}px;{% endif %}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="lp-body rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- assign cb_cols = section.blocks.size | at_most: 4 | at_least: 1 -%}
    {%- render 'cashback-icon-list', blocks: section.blocks, columns: cb_cols, icon_size: section.settings.icon_size, icon_position: section.settings.icon_position, align: section.settings.item_align, icon_color: section.settings.icon_color -%}

    {%- if section.settings.wa_link != blank or section.settings.email_label != blank -%}
      <div class="cb-steps__actions cb-steps__actions--{{ section.settings.actions_align }}">
        {%- if section.settings.wa_link != blank -%}
          <div class="cb-wa-group">
            <a class="cb-wa" href="{{ section.settings.wa_link }}" target="_blank" rel="noopener" aria-label="{{ section.settings.wa_label | escape }}">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </a>
            {%- if section.settings.wa_text != blank -%}<p class="cb-wa-text lp-body">{{ section.settings.wa_text | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.email_label != blank -%}
          <a class="button button--primary" {% if section.settings.email_link != blank %}href="{{ section.settings.email_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.email_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="cb-steps__note cb-steps__note--{{ section.settings.actions_align }}">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cashback steps",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Title (H2)" },
    { "type": "text", "id": "heading", "label": "Title", "default": "So funktioniert's" },
    { "type": "range", "id": "title_size", "label": "Title size (0 = standard)", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0, "info": "Standard H2: 28px Desktop, 26px Tablet, 22px Mobile." },
    { "type": "richtext", "id": "text", "label": "Intro text (optional)" },
    { "type": "select", "id": "text_align", "label": "Title alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "header", "content": "Icons and items" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 100 },
    { "type": "select", "id": "icon_position", "label": "Icon position", "default": "top",
      "options": [ { "value": "top", "label": "Above text" }, { "value": "left", "label": "Left of text" } ] },
    { "type": "select", "id": "item_align", "label": "Text alignment (items)", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#D6DBB9" },
    { "type": "header", "content": "WhatsApp button (icon only)" },
    { "type": "url", "id": "wa_link", "label": "WhatsApp link", "info": "wa.me-Link mit vorformulierter Nachricht." },
    { "type": "text", "id": "wa_label", "label": "Button label for screen readers", "default": "Per WhatsApp schreiben" },
    { "type": "text", "id": "wa_text", "label": "Text next to the button", "default": "Du hast Fragen? Schick uns deine Nachricht auf WhatsApp" },
    { "type": "header", "content": "E-mail button" },
    { "type": "text", "id": "email_label", "label": "Button label", "default": "Per E-Mail anfragen" },
    { "type": "url", "id": "email_link", "label": "Button link" },
    { "type": "select", "id": "actions_align", "label": "Buttons alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "note", "label": "Note under buttons (optional)" },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "check",
          "options": [
            { "value": "space", "label": "Home / space" }, { "value": "time", "label": "Clock / time" }, { "value": "money", "label": "Coin / money" },
            { "value": "leaf", "label": "Leaf" }, { "value": "recycle", "label": "Recycle" }, { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield / guarantee" }, { "value": "camera", "label": "Camera" }, { "value": "chat", "label": "Chat" },
            { "value": "mail", "label": "Mail" }, { "value": "check", "label": "Check" }, { "value": "search", "label": "Search" },
            { "value": "cart", "label": "Cart" }, { "value": "calendar", "label": "Calendar" }, { "value": "gift", "label": "Gift" }, { "value": "star", "label": "Star" }
          ] },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (overrides icon)", "info": "Optional: eigenes SVG/PNG" },
        { "type": "text", "id": "title", "label": "Title", "default": "Schritt" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cashback steps",
      "blocks": [
        { "type": "step", "settings": { "icon": "search", "title": "Rückkaufwert vorab sehen", "text": "Auf jeder Produktseite siehst du, was du später zurückbekommen kannst." } },
        { "type": "step", "settings": { "icon": "cart", "title": "Neu kaufen", "text": "Lieferung gratis." } },
        { "type": "step", "settings": { "icon": "calendar", "title": "Nutzen", "text": "So lange du willst." } },
        { "type": "step", "settings": { "icon": "recycle", "title": "Zurückgeben", "text": "Melde dich per WhatsApp oder E-Mail. Wir holen das Produkt gratis ab, prüfen es und machen dir ein Angebot." } }
      ]
    }
  ]
}
{% endschema %}