{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- stylesheet -%}
  .partner-feature { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  @media screen and (min-width: 750px) {
    .partner-feature { grid-template-columns: 1fr 1fr; gap: 6rem; }
    .partner-feature--text-first .partner-feature__media { order: 2; }
  }
  .partner-feature__media { display: flex; justify-content: center; align-items: center; padding: 3rem; border: 1px solid rgba(var(--color-foreground), 0.1); border-radius: var(--text-boxes-radius); min-width: 0; }
  .partner-feature__logo { display: block; width: 100%; max-width: var(--partner-feature-logo-width, 320px); height: auto; }
  .partner-feature__content { min-width: 0; }
  .partner-feature__heading { margin: 0; }
  .partner-feature__text { margin-top: 2rem; }
  .partner-feature__button { margin-top: 3rem; }
{%- endstylesheet -%}

{%- assign logo_alt = section.settings.heading | strip_html -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding" style="--partner-feature-logo-width: {{ section.settings.logo_width }}px;">
    <div class="partner-feature{% if section.settings.layout == 'text_first' %} partner-feature--text-first{% endif %}">
      <div class="partner-feature__media">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 1200 | image_tag: class: 'partner-feature__logo', alt: logo_alt, loading: 'lazy', widths: '400, 800, 1200' }}
        {%- endif -%}
      </div>
      <div class="partner-feature__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="partner-feature__heading inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="partner-feature__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="partner-feature__button button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}" target="_blank" rel="noopener"{% else %}role="link" aria-disabled="true"{% endif %}>
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Partner feature",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo max width", "min": 120, "max": 600, "step": 20, "unit": "px", "default": 320 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "image_first",
      "options": [ { "value": "image_first", "label": "Logo first" }, { "value": "text_first", "label": "Text first" } ] },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Partner" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1",
      "options": [ { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" }, { "value": "h0", "label": "Extra large" } ] },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "button_style_secondary", "label": "Outline button", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [ { "name": "Partner feature" } ]
}
{% endschema %}
