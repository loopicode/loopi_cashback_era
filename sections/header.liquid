<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  /* Rider: About us / Contact — desktop top-bar strip */
  .header__rider {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .header__rider {
      display: inline-flex;
      align-items: center;
      column-gap: 2rem;
      margin-right: 0.5rem;
    }

    .header__rider-link {
      font-size: 1.4rem;
      letter-spacing: 0.1rem;
      line-height: 1;
      text-decoration: none;
      color: rgba(var(--color-foreground), 0.7);
      white-space: nowrap;
    }

    .header__rider-link:hover {
      color: rgb(var(--color-foreground));
      text-decoration: underline;
      text-underline-offset: 0.3rem;
    }

    .header__rider-link--active {
      color: rgb(var(--color-foreground));
    }
  }

  /* Rider: same links as a visually separated group at the bottom of the mobile drawer */
  .menu-drawer__menu--rider {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }

  .menu-drawer__menu--rider .menu-drawer__menu-item--rider {
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.1rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  .menu-drawer__menu--rider .menu-drawer__menu-item--rider:hover {
    color: rgb(var(--color-foreground));
  }

  /* Rider drawer group: mobile/tablet only — on desktop (>=990px) these links live in the top-bar Rider strip */
  @media screen and (min-width: 990px) {
    .menu-drawer__menu--rider {
      display: none;
    }
  }

  /* Circular Cashback link next to the hamburger (desktop only; mobile uses the drawer) */
  .header__left {
    grid-area: left-icons;
    display: flex;
    align-items: center;
    column-gap: 1.6rem;
  }

  .header__cashback-link {
    font-size: 1.4rem;
    letter-spacing: 0.1rem;
    line-height: 1;
    color: rgba(var(--color-foreground), 0.7);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__cashback-link:hover {
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  /* Rider: match the desktop language selector text to the rider links */
  @media screen and (min-width: 990px) {
    .header-localization .localization-selector.localization-form__select {
      font-size: 1.4rem;
      letter-spacing: 0.1rem;
      color: rgba(var(--color-foreground), 0.7);
    }

    .header-localization .localization-selector.localization-form__select:hover {
      color: rgb(var(--color-foreground));
    }

    /* Trigger is just "DE"/"EN"/"FR" now: let the caret flow inline right after the
       text (gap controls the distance exactly) instead of being absolutely pinned to
       a wide right padding. Keeps "Kontakt -> DE" spacing untouched (padding-left stays). */
    .js .header-localization:not(.menu-drawer__localization) .localization-selector.localization-form__select {
      padding-right: 0.6rem;
      gap: 0.4rem;
    }

    .header-localization:not(.menu-drawer__localization) .localization-selector.localization-form__select .icon-caret {
      position: static;
      right: auto;
    }
  }
</style>

