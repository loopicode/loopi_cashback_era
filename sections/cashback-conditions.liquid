{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{{ 'loopi-type.css' | asset_url | stylesheet_tag }}

{%- stylesheet -%}
  .cb-cond__grid { display: grid; grid-template-columns: 1fr; gap: 2.4rem; }
  @media screen and (min-width: 750px) { .cb-cond__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (min-width: 990px) { .cb-cond__grid { grid-template-columns: repeat(var(--cb-cond-cols, 4), 1fr); } }
  .cb-cond__card { min-width: 0; border: 1px solid rgba(var(--color-foreground), 0.1); border-radius: var(--text-boxes-radius); overflow: hidden; }
  .cb-cond__media { aspect-ratio: var(--cb-cond-ratio, 1 / 1); background: rgba(var(--color-foreground), 0.05); }
  .cb-cond__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cb-cond__body { padding: 2rem; }
  .cb-cond__title { margin: 0 0 0.8rem; }
  .cb-cond__text { margin: 0; }
  .cb-cond__tips { max-width: 72rem; margin: 3.2rem auto 0; }
  .cb-cond__tips-title { margin: 0 0 1rem; }
  .cb-photo-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; padding: 2rem; text-align: center; font-size: 1.3rem; border: 1px dashed rgba(var(--color-foreground), 0.4); color: rgba(var(--color-foreground), 0.7); }
{%- endstylesheet -%}

{%- assign cb_s = section.settings.title_size | plus: 0 -%}
{%- assign cb_cond_cols = section.blocks.size | at_most: 4 | at_least: 1 -%}
{%- assign cb_ratio = '1 / 1' -%}
{%- if section.settings.image_ratio == 'landscape' -%}{%- assign cb_ratio = '4 / 3' -%}{%- endif -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="lp-head lp-head--{{ section.settings.text_align }}">
        <h2 class="lp-h2" style="{% if cb_s > 0 %}--lp-size: {{ cb_s }}px; --lp-size-t: {{ cb_s | times: 0.9 | round }}px; --lp-size-m: {{ cb_s | times: 0.8 | round }}px;{% endif %}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="lp-body rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="cb-cond__grid" style="--cb-cond-cols: {{ cb_cond_cols }}; --cb-cond-ratio: {{ cb_ratio }};">
      {%- for block in section.blocks -%}
        {%- assign cb_alt = block.settings.image.alt | default: block.settings.title -%}
        <div class="cb-cond__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or request.design_mode -%}
            <div class="cb-cond__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: alt: cb_alt, loading: 'lazy', widths: '300, 500, 800' }}
              {%- else -%}
                <div class="cb-photo-placeholder">Foto-Platz (1:1): Bild im Customizer unter &laquo;Image&raquo; auswählen</div>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="cb-cond__body">
            {%- if block.settings.title != blank -%}<h3 class="cb-cond__title lp-item-title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="cb-cond__text lp-body rte">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.tips != blank -%}
      <div class="cb-cond__tips" style="max-width: {{ section.settings.tips_width }}px;">
        {%- if section.settings.tips_heading != blank -%}<h3 class="cb-cond__tips-title lp-h3">{{ section.settings.tips_heading | escape }}</h3>{%- endif -%}
        <div class="lp-body rte">{{ section.settings.tips }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cashback conditions",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Title (H2)" },
    { "type": "text", "id": "heading", "label": "Title", "default": "In welchem Zustand ist dein Produkt?" },
    { "type": "range", "id": "title_size", "label": "Title size (0 = standard)", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0, "info": "Standard H2: 28px Desktop, 26px Tablet, 22px Mobile." },
    { "type": "richtext", "id": "text", "label": "Intro text", "default": "<p>Wir prüfen bei Tageslicht und ohne Hilfsmittel. Der Zustand bestimmt, welcher Prozentsatz gilt.</p>" },
    { "type": "select", "id": "text_align", "label": "Title alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "image_ratio", "label": "Photo shape", "default": "square",
      "options": [ { "value": "square", "label": "Square 1:1" }, { "value": "landscape", "label": "Landscape 4:3" } ] },
    { "type": "text", "id": "tips_heading", "label": "Tips heading", "default": "Tipps für den besten Wert" },
    { "type": "richtext", "id": "tips", "label": "Tips", "default": "<ul><li>Vollständig mit allem Zubehör zurückgeben.</li><li>Sauber und gereinigt.</li><li>Ohne Aufkleber oder Umbauten.</li><li>Wenn möglich in der Originalverpackung.</li></ul>" },
    { "type": "range", "id": "tips_width", "label": "Tips box width", "min": 400, "max": 1200, "step": 20, "unit": "px", "default": 720 },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "level",
      "name": "Condition level",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Zustand" },
        { "type": "richtext", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cashback conditions",
      "blocks": [
        { "type": "level", "settings": { "title": "So gut wie neu", "text": "<p>Vollständig, sauber, funktioniert einwandfrei. Auch aus nächster Nähe kaum sichtbare Kratzer oder Flecken.</p>" } },
        { "type": "level", "settings": { "title": "Leichte Gebrauchsspuren", "text": "<p>Vollständig und funktionstüchtig, einzelne feine Kratzer oder kleine Flecken. Aus 1 Meter Abstand sind keine auffälligen Spuren sichtbar.</p>" } },
        { "type": "level", "settings": { "title": "Deutliche Gebrauchsspuren", "text": "<p>Vollständig und funktionstüchtig, aber deutlich sichtbare Abnutzung. Aus 2 Meter Abstand sind keine auffälligen Flecken sichtbar.</p>" } },
        { "type": "level", "settings": { "title": "Nicht akzeptabel", "text": "<p>Risse, Brüche, bleibende Flecken, fehlende Teile, Funktionsmängel oder Veränderungen. Hier ist kein Rückkauf möglich.</p>" } }
      ]
    }
  ]
}
{% endschema %}