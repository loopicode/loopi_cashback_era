{% if recommendations.performed %}
  {% assign upsell_products = recommendations.products %}
  <div class="loopi-upsell-list">
    <h3>{{ 'loopi_cart.recommendations' | t }}</h3>
    {% assign shown = 0 %}
    {% for upsell_product in upsell_products %}
      {% assign already_added = false %}
      {% for item in cart.items %}
        {% if item.product_id == upsell_product.id %}{% assign already_added = true %}{% endif %}
      {% endfor %}
      {% if upsell_product.available and already_added == false and shown < 3 %}
        {% assign shown = shown | plus: 1 %}
        {% render 'loopi-upsell-card', upsell_product: upsell_product, card_id: section.id %}
      {% endif %}
    {% endfor %}
  </div>
{% else %}
  {% capture accessory_data %}
    {
      "month": {{ 'now' | date: '%m' | plus: 0 | json }},
      "messages": {
        "heading": {{ 'loopi_cart.recommendations' | t | json }},
        "choose": {{ 'loopi_cart.choose' | t | json }},
        "adapter_choice": {{ 'loopi_cart.adapter_choice' | t | json }},
        "more": {{ 'loopi_cart.more_accessories' | t | json }}
      },
      "items": [
        {% for item in cart.items %}
          {
            "handle": {{ item.product.handle | json }},
            "type": {{ item.product.type | json }},
            "vendor": {{ item.product.vendor | json }},
            "tags": {{ item.product.tags | json }},
            "subscription": {{ item.variant.metafields.custom.subscription.value | default: false | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  {% endcapture %}
  <script type="application/json" data-loopi-accessory-data>{{ accessory_data | replace: '<', '\u003c' }}</script>
  {% assign accessory_handles = 'sleepytroll-baby-rocker-gen-2,bugaboo-performance-footmuff,bugaboo-comfort-wheeled-board,bugaboo-organizer,bugaboo-seat-liner,bugaboo-butterfly-transporttasche,bugaboo-komfort-transporttasche,bugaboo-donkey-car-seats-adapter,nicon-wheelblades-xl-paar-schneetaugliche-kinderwagen-in-sekundenschnelle' | split: ',' %}
  {% for accessory_handle in accessory_handles %}
    {% assign accessory_product = all_products[accessory_handle] %}
    {% if accessory_product.available %}
      <template data-loopi-accessory="{{ accessory_handle }}">
        {% render 'loopi-upsell-card', upsell_product: accessory_product, card_id: section.id %}
      </template>
    {% endif %}
  {% endfor %}
{% endif %}
{% schema %}
{"name":"Cart recommendations","settings":[]}
{% endschema %}
